---
export const prerender = false;

import BaseLayout from '../components/BaseLayout.astro';
import { getAllLeadDossiers } from '../lib/dossier';
import { getAdminSession } from '../lib/session';

// Validação em Camada Dupla (Defense-in-Depth): Verifica sessão na própria página
try {
  const session = getAdminSession(Astro.cookies, Astro.request);
  if (!session) {
    return Astro.redirect('/login');
  }
} catch {
  return Astro.redirect('/login');
}

const rawProjects = await getAllLeadDossiers();
const projects = rawProjects.sort((a, b) => (a.ranking || 999) - (b.ranking || 999));
const uniqueNiches = Array.from(new Set(projects.map(p => p.niche).filter(Boolean))).sort();

const totalProjects = projects.length;
const activeCount = projects.filter(p => p.status === 'ativo' || p.status === 'published' || p.status === 'draft').length;
const inactiveCount = totalProjects - activeCount;
---

<BaseLayout title="Painel Administrativo | Plataforma Multi-Tenant">
  <div class="admin-wrapper">
    <!-- Header Admin -->
    <header class="admin-header">
      <div class="header-content">
        <div class="brand">
          <div class="brand-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
          </div>
          <div>
            <h1>Dashboard Multi-Tenant</h1>
            <p>Gerenciamento de Leads, Redesigns e Classificação de Demonstrações</p>
          </div>
        </div>

        <div class="user-profile">
          <div class="avatar">A</div>
          <div class="user-info">
            <span class="user-name">Administrador</span>
            <span class="user-role">Agência Alquimista</span>
          </div>
          <form action="/api/auth/logout" method="POST" style="margin-left: 0.75rem;">
            <button type="submit" class="btn-logout" title="Sair do Sistema" style="background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.3); color: #f87171; border-radius: 8px; padding: 0.4rem 0.8rem; font-size: 0.75rem; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 0.35rem; transition: background 0.2s;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
              <span>Sair</span>
            </button>
          </form>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="main-container">
      <!-- Top Metrics -->
      <div class="metrics-grid">
        <div class="metric-card">
          <div class="metric-icon icon-purple">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <div class="metric-info">
            <span class="metric-value">{totalProjects}</span>
            <span class="metric-label">Projetos Mapeados</span>
          </div>
        </div>

        <div class="metric-card">
          <div class="metric-icon icon-emerald">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <div class="metric-info">
            <span class="metric-value">{activeCount}</span>
            <span class="metric-label">Slugs Ativos (/site/slug)</span>
          </div>
        </div>

        <div class="metric-card">
          <div class="metric-icon icon-amber">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <div class="metric-info">
            <span class="metric-value">{inactiveCount}</span>
            <span class="metric-label">Slugs Inativos / Classificados</span>
          </div>
        </div>
      </div>

      <!-- Projects Section -->
      <section class="projects-section">
        <div class="section-header">
          <div>
            <h2>Lista de Leads e Status de Demonstração</h2>
            <p class="section-subtitle">Filtre, ordene e gerencie o pipeline comercial dos 3 agentes autônomos</p>
          </div>
          <span class="counter-badge">{totalProjects} cadastrados</span>
        </div>

        <!-- Barra de Filtros do Dashboard -->
        <div class="filters-panel">
          <div class="filters-row">
            <!-- Busca por texto -->
            <div class="filter-group search-group">
              <label for="filterSearch" class="filter-label">Buscar Lead</label>
              <div class="input-with-icon">
                <svg class="input-icon" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                <input type="text" id="filterSearch" placeholder="Nome, slug, nicho, cidade ou região..." class="filter-input" />
              </div>
            </div>

            <!-- Filtro de Região do Brasil -->
            <div class="filter-group">
              <label for="filterRegion" class="filter-label">Região do Brasil</label>
              <select id="filterRegion" class="filter-select">
                <option value="all">Todas as Regiões</option>
                <option value="sul">Região Sul (PR, SC, RS)</option>
                <option value="sudeste">Região Sudeste (SP, RJ, MG, ES)</option>
                <option value="centro-oeste">Região Centro-Oeste (DF, GO, MT, MS)</option>
                <option value="nordeste">Região Nordeste (BA, PE, CE, etc.)</option>
                <option value="norte">Região Norte (AM, PA, RO, etc.)</option>
              </select>
            </div>

            <!-- Filtro de Nicho / Segmento da Pesquisa -->
            <div class="filter-group">
              <label for="filterNiche" class="filter-label">Segmento / Nicho</label>
              <select id="filterNiche" class="filter-select">
                <option value="all">Todos os Nichos</option>
                {uniqueNiches.map(niche => (
                  <option value={niche}>{niche}</option>
                ))}
              </select>
            </div>

            <!-- Filtro de Status -->
            <div class="filter-group">
              <label for="filterStatus" class="filter-label">Status do Slug</label>
              <select id="filterStatus" class="filter-select">
                <option value="all">Todos os Status</option>
                <option value="ativo">🟢 Ativo (Slug no ar)</option>
                <option value="aprovado">🔵 Aprovado</option>
                <option value="nao_aprovado">🔴 Não Aprovado</option>
                <option value="arquivado">⚪ Arquivado</option>
              </select>
            </div>

            <!-- Filtro de Pipeline -->
            <div class="filter-group">
              <label for="filterPipeline" class="filter-label">Pipeline de Agentes</label>
              <select id="filterPipeline" class="filter-select">
                <option value="all">Todos os Estágios</option>
                <option value="completo">✅ Pipeline Completo (1+2+3)</option>
                <option value="pending-comercial">⏳ Pendente Comercial</option>
                <option value="pending-builder">⏳ Pendente Builder</option>
              </select>
            </div>

            <!-- Ordenação -->
            <div class="filter-group">
              <label for="filterSort" class="filter-label">Ordenar Por</label>
              <select id="filterSort" class="filter-select">
                <option value="ranking">🏆 Ranking Oficial (1º ao 5º)</option>
                <option value="score-desc">⚡ Maior Oportunidade (Score)</option>
                <option value="name-asc">🔤 Nome da Empresa (A → Z)</option>
                <option value="name-desc">🔤 Nome da Empresa (Z → A)</option>
              </select>
            </div>

            <!-- Botão Limpar -->
            <div class="filter-group action-group">
              <label class="filter-label">&nbsp;</label>
              <button id="btnResetFilters" type="button" class="btn-reset-filters" title="Limpar todos os filtros">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
                <span>Limpar</span>
              </button>
            </div>
          </div>

          <!-- Resumo e Tags dos Filtros Ativos -->
          <div class="filters-summary">
            <span class="results-text">
              Exibindo <strong id="filterVisibleCount">{totalProjects}</strong> de <strong id="filterTotalCount">{totalProjects}</strong> leads cadastrados
            </span>
            <div id="activeFiltersTags" class="active-tags"></div>
          </div>
        </div>

        <div class="table-container">
          <table class="projects-table">
            <thead>
              <tr>
                <th>Empresa / Cliente</th>
                <th>Nicho & Localização</th>
                <th>Status Pipeline Agentes</th>
                <th>Classificação do Slug</th>
                <th>Ações e Dossiê</th>
              </tr>
            </thead>
            <tbody>
              {projects.map(p => (
                <tr
                  class="project-row"
                  data-slug={p.slug}
                  data-name={p.name.toLowerCase()}
                  data-niche={(p.searchNiche || p.niche).toLowerCase()}
                  data-detailed-niche={(p.detailedNiche || '').toLowerCase()}
                  data-region={(p.region || 'sul').toLowerCase()}
                  data-city={p.city.toLowerCase()}
                  data-state={p.state.toLowerCase()}
                  data-status={p.status}
                  data-ranking={p.ranking || 999}
                  data-score={p.score || 0}
                  data-pipeline-prospector={p.pipeline?.prospector ? 'true' : 'false'}
                  data-pipeline-builder={p.pipeline?.builder ? 'true' : 'false'}
                  data-pipeline-comercial={p.pipeline?.comercial ? 'true' : 'false'}
                >
                  <td>
                    <div class="client-name-wrap">
                      <div class="client-title-row">
                        {p.ranking <= 5 ? (
                          <span class={`rank-badge rank-badge-${p.ranking <= 3 ? p.ranking : 'other'}`}>#{p.ranking}</span>
                        ) : null}
                        <span class="client-name">{p.name}</span>
                        {p.score > 0 ? (
                          <span class="score-pill">Score {p.score}</span>
                        ) : null}
                      </div>
                      <div class="client-slug">/site/{p.slug}</div>
                    </div>
                  </td>
                  <td>
                    <div class="niche-cell-wrap">
                      <span class="macro-niche-tag">{p.searchNiche || p.niche}</span>
                      {p.detailedNiche && p.detailedNiche !== (p.searchNiche || p.niche) ? (
                        <div class="client-detail-niche" title={p.detailedNiche}>{p.detailedNiche}</div>
                      ) : null}
                      <div class="client-city">
                        <span>{p.city} - {p.state}</span>
                        <span class="region-pill">Região {p.region}</span>
                      </div>
                    </div>
                  </td>
                  <td>
                    <div class="pipeline-steps">
                      <span class={`pipe-step ${p.pipeline?.prospector ? 'active' : ''}`}>1. Prospector</span>
                      <span class={`pipe-step ${p.pipeline?.builder ? 'active' : ''}`}>2. Builder</span>
                      <span class={`pipe-step ${p.pipeline?.comercial ? 'active' : ''}`}>3. Comercial</span>
                    </div>
                  </td>
                  <td>
                    <select class="status-select" data-slug={p.slug}>
                      <option value="ativo" selected={p.status === 'ativo' || p.status === 'published' || p.status === 'draft'}>🟢 Ativo (Slug Ativo)</option>
                      <option value="aprovado" selected={p.status === 'aprovado' || p.status === 'approved'}>🔵 Aprovado (Slug Inativo)</option>
                      <option value="nao_aprovado" selected={p.status === 'nao_aprovado'}>🔴 Não Aprovado (Slug Inativo)</option>
                      <option value="arquivado" selected={p.status === 'arquivado'}>⚪ Arquivado (Slug Inativo)</option>
                    </select>
                  </td>
                  <td>
                    <div class="actions-wrap">
                      <button class="btn-action btn-dossier btn-open-modal" data-slug={p.slug}>
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                        <span>Dossiê Completo</span>
                      </button>

                      <a href={`/site/${p.slug}`} target="_blank" class="btn-action btn-preview">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                        <span>Ver Site</span>
                      </a>
                    </div>
                  </td>
                </tr>
              ))}
              <tr id="emptyResultsRow" style="display: none;">
                <td colspan="5" class="empty-results-cell">
                  <div class="empty-state">
                    <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                    <p>Nenhum lead encontrado com os filtros selecionados.</p>
                    <button type="button" id="btnResetFromEmpty" class="btn-reset-empty">Limpar Filtros</button>
                  </div>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>
    </main>
  </div>

  <!-- MODAL DOSSIÊ DE LEADS -->
  <div id="dossierModal" class="modal-backdrop" style="display: none;">
    <div class="modal-dialog">
      <!-- Modal Header -->
      <div class="modal-header">
        <div class="modal-title-wrap">
          <span class="badge-tag">Dossiê 360° do Lead</span>
          <h2 id="modalTitle">Nome da Empresa</h2>
          <p id="modalSub">Nicho & Cidade</p>
        </div>
        <button id="btnCloseModal" class="modal-close-btn">&times;</button>
      </div>

      <!-- Navigation Tabs -->
      <div class="modal-tabs">
        <button class="tab-btn active" data-tab="tab-prospector">
          <span class="tab-icon">🔍</span>
          <span>1. Prospector (Auditoria)</span>
        </button>
        <button class="tab-btn" data-tab="tab-builder">
          <span class="tab-icon">🛠️</span>
          <span>2. Builder (Redesign)</span>
        </button>
        <button class="tab-btn" data-tab="tab-comercial">
          <span class="tab-icon">💼</span>
          <span>3. Comercial (Abordagem)</span>
        </button>
        <button class="tab-btn" data-tab="tab-contacts">
          <span class="tab-icon">📞</span>
          <span>Contatos do Cliente</span>
        </button>
      </div>

      <!-- Modal Body (Tab Panels) -->
      <div class="modal-body">
        <!-- TAB 1: PROSPECTOR -->
        <div id="tab-prospector" class="tab-panel active">
          <div class="panel-grid">
            <div class="panel-card">
              <h3>Score & Diagnóstico de Entrada</h3>
              <div class="metrics-row">
                <div class="metric-box">
                  <span class="m-val" id="prospectorScore">-</span>
                  <span class="m-lbl">Score Atual</span>
                </div>
                <div class="metric-box">
                  <span class="m-val" id="prospectorPagespeed">-</span>
                  <span class="m-lbl">PageSpeed Mobile</span>
                </div>
              </div>
              <div class="gap-box">
                <strong>Gargalo Principal:</strong>
                <p id="prospectorGap">-</p>
              </div>
            </div>

            <div class="panel-card">
              <h3>Screenshots do Site Antigo</h3>
              <div class="screenshots-row">
                <div class="shot-box">
                  <span>Desktop Original</span>
                  <img id="imgOriginalDesktop" src="" alt="Site Antigo Desktop" loading="lazy" onerror="this.onerror=null;this.src='/placeholder.svg';" />
                </div>
                <div class="shot-box">
                  <span>Mobile Original</span>
                  <img id="imgOriginalMobile" src="" alt="Site Antigo Mobile" loading="lazy" onerror="this.onerror=null;this.src='/placeholder.svg';" />
                </div>
              </div>
            </div>
          </div>

          <div class="panel-card full-width" style="margin-top: 1rem;">
            <h3>Auditoria Completa (Markdown)</h3>
            <div id="prospectorMarkdown" class="markdown-preview"></div>
          </div>
        </div>

        <!-- TAB 2: BUILDER -->
        <div id="tab-builder" class="tab-panel">
          <div class="panel-grid">
            <div class="panel-card">
              <h3>Demonstrativo em Tempo Real</h3>
              <p>O site foi reconstruído com componentes modulares Astro e Tailwind CSS v4 no design system.</p>
              <div class="link-box">
                <a id="builderPreviewLink" href="#" target="_blank" class="btn-primary-link">
                  🚀 Abrir Demonstração (/site/slug)
                </a>
              </div>

              <div class="component-list">
                <h4>Componentes Utilizados:</h4>
                <ul id="builderComponentsList">
                  <li>Hero Section (Hero01)</li>
                  <li>Benefícios & Grid (Benefits01)</li>
                  <li>Formulário Lead & CTA</li>
                </ul>
              </div>
            </div>

            <div class="panel-card">
              <h3>Screenshots do Redesign</h3>
              <div class="screenshots-row">
                <div class="shot-box">
                  <span>Novo Desktop</span>
                  <img id="imgRedesignDesktop" src="" alt="Novo Desktop" loading="lazy" onerror="this.onerror=null;this.src='/placeholder.svg';" />
                </div>
                <div class="shot-box">
                  <span>Novo Mobile</span>
                  <img id="imgRedesignMobile" src="" alt="Novo Mobile" loading="lazy" onerror="this.onerror=null;this.src='/placeholder.svg';" />
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- TAB 3: COMERCIAL -->
        <div id="tab-comercial" class="tab-panel">
          <div class="panel-card full-width">
            <h3>Card de Comparação Visual (Antes × Depois)</h3>
            <div class="before-after-container">
              <img id="imgBeforeAfter" src="" alt="Comparativo Antes vs Depois" loading="lazy" onerror="this.onerror=null;this.src='/placeholder.svg';" />
            </div>
          </div>

          <div class="panel-grid" style="margin-top: 1rem;">
            <!-- E-mail Proposal -->
            <div class="panel-card">
              <div class="card-header-actions">
                <h3>Proposta por E-mail</h3>
                <button id="btnCopyEmail" class="btn-copy">📋 Copiar E-mail</button>
              </div>
              <div class="subject-line">
                <strong>Assunto:</strong> <span id="emailSubject">-</span>
              </div>
              <textarea id="emailBody" class="script-textarea" readonly rows="10"></textarea>
            </div>

            <!-- WhatsApp Scripts -->
            <div class="panel-card">
              <div class="card-header-actions">
                <h3>Scripts WhatsApp</h3>
                <button id="btnCopyWsp" class="btn-copy">📋 Copiar Mensagem</button>
              </div>
              <div class="wsp-selector">
                <label><input type="radio" name="wspType" value="optA" checked /> Opção A (Direta)</label>
                <label style="margin-left: 1rem;"><input type="radio" name="wspType" value="optB" /> Opção B (Consultiva)</label>
              </div>
              <textarea id="wspBody" class="script-textarea" readonly rows="10"></textarea>
            </div>
          </div>

          <div class="panel-grid" style="margin-top: 1rem;">
            <div class="panel-card">
              <h3>Pontos de Bolso para Reunião</h3>
              <div id="wspPocketPoints" class="markdown-preview"></div>
            </div>
            <div class="panel-card">
              <h3>Matriz de Objeções</h3>
              <div id="objectionsContent" class="markdown-preview"></div>
            </div>
          </div>
        </div>

        <!-- TAB 4: CONTACTS -->
        <div id="tab-contacts" class="tab-panel">
          <div class="panel-card full-width">
            <h3>Dados de Contato e Localização do Lead</h3>
            <div class="contacts-grid">
              <div class="contact-item">
                <span class="c-label">Telefone Fixo / Comercial</span>
                <span class="c-value" id="cPhone">-</span>
              </div>
              <div class="contact-item">
                <span class="c-label">WhatsApp</span>
                <span class="c-value" id="cWhatsapp">-</span>
                <a id="linkWspDirect" href="#" target="_blank" class="btn-wsp-direct" style="display:none; margin-top: 0.5rem;">
                  💬 Iniciar Conversa no WhatsApp
                </a>
              </div>
              <div class="contact-item">
                <span class="c-label">E-mail Principal</span>
                <span class="c-value" id="cEmail">-</span>
              </div>
              <div class="contact-item">
                <span class="c-label">Instagram</span>
                <span class="c-value" id="cInstagram">-</span>
              </div>
              <div class="contact-item">
                <span class="c-label">Endereço Físico</span>
                <span class="c-value" id="cAddress">-</span>
              </div>
              <div class="contact-item">
                <span class="c-label">Site Original</span>
                <span class="c-value" id="cWebsite">-</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Injeta dados dos projetos no JS do cliente -->
  <script is:inline define:vars={{ projects }}>
    window.DOSSIER_DATA = {};
    projects.forEach(p => {
      window.DOSSIER_DATA[p.slug] = p;
    });
  </script>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const modal = document.getElementById('dossierModal');
      const btnClose = document.getElementById('btnCloseModal');
      const tabBtns = document.querySelectorAll('.tab-btn');
      const tabPanels = document.querySelectorAll('.tab-panel');

      let currentProject = null;

      // Atualizar Status via API ao mudar Select na Tabela
      document.querySelectorAll('.status-select').forEach(select => {
        select.addEventListener('change', async (e) => {
          const slug = select.getAttribute('data-slug');
          const status = e.target.value;
          select.disabled = true;

          try {
            const res = await fetch('/api/lead-status', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ slug, status })
            });
            if (res.ok) {
              select.style.borderColor = '#10b981';
              setTimeout(() => { select.style.borderColor = ''; }, 1500);
            }
          } catch (err) {
            console.error('Falha ao atualizar status:', err);
          } finally {
            select.disabled = false;
          }
        });
      });

      // Event Listeners para abrir modal
      document.querySelectorAll('.btn-open-modal').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const slug = btn.getAttribute('data-slug');
          const data = window.DOSSIER_DATA[slug];
          if (data) {
            openDossierModal(data);
          }
        });
      });

      // Event Listener para fechar modal
      if (btnClose) {
        btnClose.addEventListener('click', () => {
          modal.style.display = 'none';
        });
      }

      // Tabs click
      tabBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          tabBtns.forEach(b => b.classList.remove('active'));
          tabPanels.forEach(p => p.classList.remove('active'));

          btn.classList.add('active');
          const targetTab = btn.getAttribute('data-tab');
          const panel = document.getElementById(targetTab);
          if (panel) panel.classList.add('active');
        });
      });

      // Alternar Script WhatsApp
      const wspRadios = document.querySelectorAll('input[name="wspType"]');
      wspRadios.forEach(radio => {
        radio.addEventListener('change', (e) => {
          if (!currentProject || !currentProject.comercial) return;
          const val = e.target.value;
          const wspTextarea = document.getElementById('wspBody');
          if (val === 'optA') {
            wspTextarea.value = currentProject.comercial.whatsappOptionA || 'Não configurado';
          } else {
            wspTextarea.value = currentProject.comercial.whatsappOptionB || 'Não configurado';
          }
        });
      });

      // Copiar E-mail
      const btnCopyEmail = document.getElementById('btnCopyEmail');
      if (btnCopyEmail) {
        btnCopyEmail.addEventListener('click', () => {
          const subj = document.getElementById('emailSubject').innerText;
          const body = document.getElementById('emailBody').value;
          const textToCopy = `Assunto: ${subj}\n\n${body}`;
          navigator.clipboard.writeText(textToCopy).then(() => {
            btnCopyEmail.innerText = '✅ Copiado!';
            setTimeout(() => { btnCopyEmail.innerText = '📋 Copiar E-mail'; }, 2000);
          });
        });
      }

      // Copiar WhatsApp
      const btnCopyWsp = document.getElementById('btnCopyWsp');
      if (btnCopyWsp) {
        btnCopyWsp.addEventListener('click', () => {
          const body = document.getElementById('wspBody').value;
          navigator.clipboard.writeText(body).then(() => {
            btnCopyWsp.innerText = '✅ Copiado!';
            setTimeout(() => { btnCopyWsp.innerText = '📋 Copiar Mensagem'; }, 2000);
          });
        });
      }

      // === SISTEMA DE FILTROS E BUSCA DO DASHBOARD ===
      const filterSearch = document.getElementById('filterSearch');
      const filterRegion = document.getElementById('filterRegion');
      const filterNiche = document.getElementById('filterNiche');
      const filterStatus = document.getElementById('filterStatus');
      const filterPipeline = document.getElementById('filterPipeline');
      const filterSort = document.getElementById('filterSort');
      const btnResetFilters = document.getElementById('btnResetFilters');
      const btnResetFromEmpty = document.getElementById('btnResetFromEmpty');
      const filterVisibleCount = document.getElementById('filterVisibleCount');
      const activeFiltersTags = document.getElementById('activeFiltersTags');
      const emptyResultsRow = document.getElementById('emptyResultsRow');
      const tableBody = document.querySelector('.projects-table tbody');

      function filterAndSortLeads() {
        const query = (filterSearch ? filterSearch.value : '').trim().toLowerCase();
        const regionVal = filterRegion ? filterRegion.value : 'all';
        const nicheVal = filterNiche ? filterNiche.value : 'all';
        const statusVal = filterStatus ? filterStatus.value : 'all';
        const pipeVal = filterPipeline ? filterPipeline.value : 'all';
        const sortVal = filterSort ? filterSort.value : 'ranking';

        const rows = Array.from(document.querySelectorAll('.project-row'));
        let visibleCount = 0;
        const visibleRows = [];

        rows.forEach(row => {
          const name = row.getAttribute('data-name') || '';
          const slug = row.getAttribute('data-slug') || '';
          const niche = row.getAttribute('data-niche') || '';
          const detailedNiche = row.getAttribute('data-detailed-niche') || '';
          const region = row.getAttribute('data-region') || '';
          const city = row.getAttribute('data-city') || '';
          const state = row.getAttribute('data-state') || '';
          const status = row.getAttribute('data-status') || '';
          const pipePros = row.getAttribute('data-pipeline-prospector') === 'true';
          const pipeBld = row.getAttribute('data-pipeline-builder') === 'true';
          const pipeCom = row.getAttribute('data-pipeline-comercial') === 'true';

          // 1. Busca por Texto (nome, slug, nicho macro, segmento detalhado, cidade, estado, região)
          const matchesQuery = !query || 
            name.includes(query) || 
            slug.includes(query) || 
            niche.includes(query) || 
            detailedNiche.includes(query) || 
            region.includes(query) || 
            city.includes(query) || 
            state.includes(query);

          // 2. Filtro de Região do Brasil
          const matchesRegion = (regionVal === 'all') || (region === regionVal.toLowerCase());

          // 3. Filtro de Segmento / Nicho (pesquisa macro)
          const matchesNiche = (nicheVal === 'all') || (niche === nicheVal.toLowerCase());

          // 4. Filtro de Status
          let matchesStatus = true;
          if (statusVal === 'ativo') {
            matchesStatus = (status === 'ativo' || status === 'published' || status === 'draft');
          } else if (statusVal === 'aprovado') {
            matchesStatus = (status === 'aprovado' || status === 'approved');
          } else if (statusVal === 'nao_aprovado') {
            matchesStatus = (status === 'nao_aprovado');
          } else if (statusVal === 'arquivado') {
            matchesStatus = (status === 'arquivado');
          }

          // 5. Filtro de Pipeline
          let matchesPipeline = true;
          if (pipeVal === 'completo') {
            matchesPipeline = (pipePros && pipeBld && pipeCom);
          } else if (pipeVal === 'pending-comercial') {
            matchesPipeline = !pipeCom;
          } else if (pipeVal === 'pending-builder') {
            matchesPipeline = !pipeBld;
          }

          if (matchesQuery && matchesRegion && matchesNiche && matchesStatus && matchesPipeline) {
            row.style.display = '';
            visibleRows.push(row);
            visibleCount++;
          } else {
            row.style.display = 'none';
          }
        });

        // 6. Ordenação
        visibleRows.sort((a, b) => {
          if (sortVal === 'ranking') {
            const rA = parseInt(a.getAttribute('data-ranking') || '999', 10);
            const rB = parseInt(b.getAttribute('data-ranking') || '999', 10);
            return rA - rB;
          } else if (sortVal === 'score-desc') {
            const sA = parseFloat(a.getAttribute('data-score') || '0');
            const sB = parseFloat(b.getAttribute('data-score') || '0');
            return sB - sA;
          } else if (sortVal === 'name-asc') {
            return (a.getAttribute('data-name') || '').localeCompare(b.getAttribute('data-name') || '');
          } else if (sortVal === 'name-desc') {
            return (b.getAttribute('data-name') || '').localeCompare(a.getAttribute('data-name') || '');
          }
          return 0;
        });

        // Reordenar no DOM
        if (tableBody) {
          visibleRows.forEach(row => {
            tableBody.appendChild(row);
          });
          if (emptyResultsRow) {
            tableBody.appendChild(emptyResultsRow);
          }
        }

        // Atualizar Contador
        if (filterVisibleCount) {
          filterVisibleCount.innerText = visibleCount.toString();
        }

        // Empty state
        if (emptyResultsRow) {
          emptyResultsRow.style.display = (visibleCount === 0) ? '' : 'none';
        }

        // Renderizar tags de filtros ativos
        renderActiveFilterTags(query, regionVal, nicheVal, statusVal, pipeVal, sortVal);
      }

      function renderActiveFilterTags(query, regionVal, nicheVal, statusVal, pipeVal, sortVal) {
        if (!activeFiltersTags) return;
        activeFiltersTags.innerHTML = '';

        if (query) {
          addTag(`Busca: "${query}"`, () => {
            if (filterSearch) filterSearch.value = '';
            filterAndSortLeads();
          });
        }
        if (regionVal !== 'all') {
          const opt = filterRegion?.options[filterRegion.selectedIndex];
          addTag(`Região: ${opt ? opt.text.split('(')[0].trim() : regionVal}`, () => {
            if (filterRegion) filterRegion.value = 'all';
            filterAndSortLeads();
          });
        }
        if (nicheVal !== 'all') {
          addTag(`Nicho: ${nicheVal}`, () => {
            if (filterNiche) filterNiche.value = 'all';
            filterAndSortLeads();
          });
        }
        if (statusVal !== 'all') {
          const opt = filterStatus?.options[filterStatus.selectedIndex];
          addTag(`Status: ${opt ? opt.text : statusVal}`, () => {
            if (filterStatus) filterStatus.value = 'all';
            filterAndSortLeads();
          });
        }
        if (pipeVal !== 'all') {
          const opt = filterPipeline?.options[filterPipeline.selectedIndex];
          addTag(`Pipeline: ${opt ? opt.text : pipeVal}`, () => {
            if (filterPipeline) filterPipeline.value = 'all';
            filterAndSortLeads();
          });
        }
        if (sortVal !== 'ranking') {
          const opt = filterSort?.options[filterSort.selectedIndex];
          addTag(`Ordem: ${opt ? opt.text : sortVal}`, () => {
            if (filterSort) filterSort.value = 'ranking';
            filterAndSortLeads();
          });
        }
      }

      function addTag(label, onRemove) {
        const span = document.createElement('span');
        span.className = 'filter-chip';
        span.innerHTML = `${label} <button type="button" class="chip-remove" title="Remover filtro">&times;</button>`;
        const btn = span.querySelector('.chip-remove');
        if (btn) btn.addEventListener('click', onRemove);
        activeFiltersTags.appendChild(span);
      }

      function resetAllFilters() {
        if (filterSearch) filterSearch.value = '';
        if (filterRegion) filterRegion.value = 'all';
        if (filterNiche) filterNiche.value = 'all';
        if (filterStatus) filterStatus.value = 'all';
        if (filterPipeline) filterPipeline.value = 'all';
        if (filterSort) filterSort.value = 'ranking';
        filterAndSortLeads();
      }

      // Listeners dos filtros
      if (filterSearch) filterSearch.addEventListener('input', filterAndSortLeads);
      if (filterRegion) filterRegion.addEventListener('change', filterAndSortLeads);
      if (filterNiche) filterNiche.addEventListener('change', filterAndSortLeads);
      if (filterStatus) filterStatus.addEventListener('change', filterAndSortLeads);
      if (filterPipeline) filterPipeline.addEventListener('change', filterAndSortLeads);
      if (filterSort) filterSort.addEventListener('change', filterAndSortLeads);

      if (btnResetFilters) btnResetFilters.addEventListener('click', resetAllFilters);
      if (btnResetFromEmpty) btnResetFromEmpty.addEventListener('click', resetAllFilters);

      function openDossierModal(data) {
        currentProject = data;

        // Header info
        document.getElementById('modalTitle').innerText = data.name;
        document.getElementById('modalSub').innerText = `${data.niche} | ${data.city} - ${data.state}`;

        // 1. Prospector Data
        const p = data.prospector || {};
        document.getElementById('prospectorScore').innerText = p.score || 'N/A';
        document.getElementById('prospectorPagespeed').innerText = p.pagespeedMobile ? `${p.pagespeedMobile}/100` : 'N/A';
        document.getElementById('prospectorGap').innerText = p.mainGap || 'Auditoria concluída sem ressalvas impeditivas.';
        document.getElementById('prospectorMarkdown').innerHTML = formatMarkdown(p.auditoriaMarkdown || 'Nenhuma auditoria em texto gerada.');

        const imgOrigDesk = document.getElementById('imgOriginalDesktop');
        const imgOrigMob = document.getElementById('imgOriginalMobile');
        imgOrigDesk.src = p.originalDesktopScreenshot || '/placeholder.svg';
        imgOrigMob.src = p.originalMobileScreenshot || '/placeholder.svg';

        // 2. Builder Data
        const b = data.builder || {};
        const previewLink = document.getElementById('builderPreviewLink');
        previewLink.href = `/site/${data.slug}`;

        document.getElementById('imgRedesignDesktop').src = b.redesignDesktopScreenshot || '/placeholder.svg';
        document.getElementById('imgRedesignMobile').src = b.redesignMobileScreenshot || '/placeholder.svg';

        const compList = document.getElementById('builderComponentsList');
        if (b.componentsUsed && b.componentsUsed.length > 0) {
          compList.innerHTML = b.componentsUsed.map(c => `<li>${c}</li>`).join('');
        } else {
          compList.innerHTML = '<li>Hero01</li><li>Benefits01</li><li>Footer01</li>';
        }

        // 3. Comercial Data
        const c = data.comercial || {};
        document.getElementById('imgBeforeAfter').src = c.beforeAfterImage || '/placeholder.svg';

        const emailSubj = document.getElementById('emailSubject');
        const emailBody = document.getElementById('emailBody');
        emailSubj.innerText = c.emailSubject || 'Apresentação de Redesign Institucional';
        emailBody.value = c.emailBody || 'Nenhuma proposta formatada.';

        const optA = document.querySelector('input[value="optA"]');
        if (optA) optA.checked = true;
        document.getElementById('wspBody').value = c.whatsappOptionA || 'Nenhum script configurado.';

        document.getElementById('wspPocketPoints').innerHTML = formatMarkdown(c.whatsappPocketPoints || 'Nenhum ponto registrado.');
        document.getElementById('objectionsContent').innerHTML = formatMarkdown(c.objectionsMarkdown || 'Sem objeções registradas.');

        // 4. Contacts Data
        const contacts = data.contacts || {};
        document.getElementById('cPhone').innerText = contacts.phone || 'Não informado';

        const cWsp = document.getElementById('cWhatsapp');
        const linkWsp = document.getElementById('linkWspDirect');
        if (contacts.whatsapp) {
          cWsp.innerText = contacts.whatsapp;
          const cleanNum = contacts.whatsapp.replace(/\D/g, '');
          linkWsp.href = `https://wa.me/${cleanNum}`;
          linkWsp.style.display = 'inline-block';
        } else {
          cWsp.innerText = 'Não informado';
          linkWsp.style.display = 'none';
        }

        document.getElementById('cEmail').innerText = contacts.email || 'Não informado';
        document.getElementById('cInstagram').innerText = contacts.instagram || 'Não informado';
        document.getElementById('cAddress').innerText = contacts.address || 'Não informado';
        
        const cWeb = document.getElementById('cWebsite');
        if (contacts.website) {
          cWeb.innerHTML = `<a href="${contacts.website}" target="_blank" style="color: #6366f1; text-decoration: underline;">${contacts.website}</a>`;
        } else {
          cWeb.innerText = 'Não informado';
        }

        // Display modal
        modal.style.display = 'flex';
      }

      function formatMarkdown(txt) {
        if (!txt) return '';
        return txt
          .replace(/^### (.*$)/gim, '<h4>$1</h4>')
          .replace(/^## (.*$)/gim, '<h3>$1</h3>')
          .replace(/^# (.*$)/gim, '<h2>$1</h2>')
          .replace(/^\> (.*$)/gim, '<blockquote>$1</blockquote>')
          .replace(/```([\s\S]*?)```/gim, '<pre><code>$1</code></pre>')
          .replace(/`([^`]+)`/gim, '<code>$1</code>')
          .replace(/~([^~]+)~/gim, '<del>$1</del>')
          .replace(/\*\*([^*]+)\*\*/gim, '<strong>$1</strong>')
          .replace(/\*([^*]+)\*/gim, '<strong>$1</strong>')
          .replace(/_([^_]+)_/gim, '<em>$1</em>')
          .replace(/\n/g, '<br>');
      }
    });
  </script>

