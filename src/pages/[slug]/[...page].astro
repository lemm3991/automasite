---
import { getPublishedClients } from '../../clients/registry';
import type { ClientConfig, PageConfig } from '../../clients/schema';
import BaseLayout from '../../components/BaseLayout.astro';
import SectionRenderer from '../../components/SectionRenderer.astro';

export async function getStaticPaths() {
  const published = await getPublishedClients();
  const paths: any[] = [];
  for (const client of published) {
    for (const page of client.pages) {
      if (page.path !== "") {
        paths.push({
          params: { slug: client.slug, page: page.path },
          props: { client, page }
        });
      }
    }
  }
  return paths;
}

interface Props {
  client: ClientConfig;
  page: PageConfig;
}

const { client, page } = Astro.props;
---

<BaseLayout client={client} title={page.seo.title} description={page.seo.description} isPrivatePreview={true}>
  <main>
    {page.sections.map(section => (
      <SectionRenderer section={section} client={client} />
    ))}
  </main>
</BaseLayout>