---
const {content} = Astro.props;
---
<section id="materiais" class="sj-section sj-materials"><div class="sj-wrap sj-materials-grid">
  <div><p class="sj-kicker">03 / MATÉRIAS-PRIMAS</p><h2>{content.title}</h2><p>{content.description}</p><span class="sj-material-note">{content.note}</span></div>
  <div class="sj-material-list">{content.items.map((m:any,i:number)=><article class="sj-material-row"><span class="sj-row-index">0{i+1}</span><div><h3>{m.name}</h3><p>{m.description}</p></div><svg aria-hidden="true" width="62" height="50" viewBox="0 0 62 50" fill="none"><path d="M3 17L34 4 59 18 28 33 3 17ZM3 24L28 40 59 25M3 31L28 47 59 32" stroke="currentColor" stroke-width="1.4"/></svg></article>)}</div>
</div></section>
