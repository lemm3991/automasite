---
const {content,client} = Astro.props;
---
<section id="contato" class="sj-section sj-contact"><div class="sj-wrap sj-contact-grid">
  <div><p class="sj-kicker">05 / VAMOS CONVERSAR</p><h2>{content.title}</h2><p class="sj-contact-intro">{content.description}</p><a class="sj-phone" href={`tel:+55${client.business.phone.replace(/\D/g,'')}`}>{client.business.phone} <span aria-hidden="true">↗</span></a><div class="sj-address"><div><span class="sj-label">ONDE ESTAMOS</span><address>{client.business.address}</address><a href={content.mapHref} target="_blank" rel="noopener noreferrer">Ver no mapa ↗</a></div><div><span class="sj-label">ATENDIMENTO</span><p>Segunda a sexta<br/>8h às 12h · 13h às 17h</p></div></div></div>
  <form class="sj-quote" data-whatsapp={content.whatsapp}><p class="sj-label">SEU PROJETO COMEÇA AQUI</p><h3>Conte o que você precisa.</h3><label for="sj-material">Material</label><select id="sj-material" name="material"><option>Aço carbono</option><option>Chapa galvanizada</option><option>Quero orientação</option></select><div class="sj-form-row"><div><label for="sj-service">Serviço</label><select id="sj-service" name="service"><option>Corte e dobra</option><option>Calandragem</option><option>Recorte a plasma</option><option>Lambri sob medida</option></select></div><div><label for="sj-thickness">Espessura <span>(opcional)</span></label><input id="sj-thickness" name="thickness" placeholder="Ex.: 3 mm" maxlength="80" /></div></div><label for="sj-details">Medidas e detalhes <span>(opcional)</span></label><textarea id="sj-details" name="details" rows="3" maxlength="1600" placeholder="Descreva as medidas, a quantidade e sua necessidade."></textarea><button class="sj-button" type="submit">Preparar cotação no WhatsApp <span aria-hidden="true">↗</span></button><p class="sj-form-note">Você será direcionado ao WhatsApp para enviar a mensagem à São Jorge.</p><noscript><a href={`https://wa.me/${content.whatsapp}`}>Falar diretamente no WhatsApp</a></noscript></form>
</div></section>
<script>
const form=document.querySelector<HTMLFormElement>('.sj-quote');
form?.addEventListener('submit',event=>{event.preventDefault();const data=new FormData(form);const text=['Olá, São Jorge! Gostaria de solicitar um orçamento.',`Material: ${data.get('material')}`,`Serviço: ${data.get('service')}`,data.get('thickness')?`Espessura: ${data.get('thickness')}`:'',data.get('details')?`Detalhes: ${data.get('details')}`:''].filter(Boolean).join('\n');window.open(`https://wa.me/${form.dataset.whatsapp}?text=${encodeURIComponent(text)}`,'_blank','noopener,noreferrer');});
</script>
