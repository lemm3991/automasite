---
import './editorial.css';

interface Props {
  content?: {
    title?: string;
    subtitle?: string;
  };
}

const { content = {} } = Astro.props;
const title = content.title || "Nossas Unidades em Santa Catarina";
---

<section id="unidades" class="py-20 sm:py-28 bg-[#0f0f11] text-white border-t border-white/5 relative" data-surface-rhythm="editorial-noir-rhythm" data-card-treatment="minimal-glass-stroke">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white/5 border border-white/10 text-xs font-semibold tracking-wider text-[#803050] uppercase">
        <span>Localização & Atendimento</span>
      </div>
      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-normal text-white tracking-tight">
        {title}
      </h2>
      <p class="text-sm sm:text-base text-white/70 font-light max-w-2xl mx-auto leading-relaxed">
        Presença consolidada nas duas cidades de Santa Catarina para atender você no coração financeiro de Criciúma e durante seus momentos de descanso em Balneário Rincão.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
      
      <!-- Unidade Criciúma (Matriz) -->
      <div class="p-8 rounded-3xl bg-white/[0.03] border border-white/10 hover:border-[#803050]/50 transition-all duration-300 space-y-6 flex flex-col justify-between">
        <div class="space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-xs font-semibold tracking-wider text-white/90">
            <span class="w-2 h-2 rounded-full bg-[#803050]"></span>
            <span>Matriz Histórica</span>
          </div>

          <h3 class="font-serif text-2xl font-medium text-white">Unidade Centro Criciúma</h3>
          
          <div class="space-y-2 text-sm text-white/75 font-light">
            <p class="font-medium text-white">Centro, Criciúma — SC</p>
            <p class="text-xs text-white/65">Atendimento Presencial na Matriz</p>
          </div>

          <div class="pt-2">
            <p class="text-xs text-white/60 uppercase tracking-widest font-semibold">Telefone de Contato:</p>
            <a href="tel:4834331789" class="text-lg font-serif font-medium text-[#fcfbfb] hover:text-[#803050] transition-colors">
              48 3433 1789
            </a>
          </div>
        </div>

        <div class="pt-4 flex flex-col sm:flex-row gap-3">
          <a href="https://wa.me/554834331789?text=Olá,%20gostaria%20de%20agendar%20um%20horário%20em%20Criciúma" class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-[#803050] hover:bg-[#802050] text-xs font-semibold text-white transition-colors">
            <span>WhatsApp Criciúma</span>
          </a>
          <a href="tel:4834331789" class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-white/5 hover:bg-white/10 border border-white/10 text-xs font-medium text-white/80 transition-colors">
            <span>Ligar para Matriz</span>
          </a>
        </div>
      </div>

      <!-- Unidade Balneário Rincão (Filial) -->
      <div class="p-8 rounded-3xl bg-white/[0.03] border border-white/10 hover:border-[#803050]/50 transition-all duration-300 space-y-6 flex flex-col justify-between">
        <div class="space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-xs font-semibold tracking-wider text-white/90">
            <span class="w-2 h-2 rounded-full bg-[#802050]"></span>
            <span>Filial Litoral</span>
          </div>

          <h3 class="font-serif text-2xl font-medium text-white">Unidade Balneário Rincão</h3>
          
          <div class="space-y-2 text-sm text-white/75 font-light">
            <p class="font-medium text-white">Centro, Balneário Rincão — SC</p>
            <p class="text-xs text-white/65">Atendimento Presencial no Litoral</p>
          </div>

          <div class="pt-2">
            <p class="text-xs text-white/60 uppercase tracking-widest font-semibold">Telefone de Contato:</p>
            <a href="tel:4834681297" class="text-lg font-serif font-medium text-[#fcfbfb] hover:text-[#803050] transition-colors">
              48 3468 1297
            </a>
          </div>
        </div>

        <div class="pt-4 flex flex-col sm:flex-row gap-3">
          <a href="https://wa.me/554834681297?text=Olá,%20gostaria%20de%20agendar%20um%20horário%20em%20Balneário%20Rincão" class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-[#803050] hover:bg-[#802050] text-xs font-semibold text-white transition-colors">
            <span>WhatsApp Rincão</span>
          </a>
          <a href="tel:4834681297" class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-white/5 hover:bg-white/10 border border-white/10 text-xs font-medium text-white/80 transition-colors">
            <span>Ligar para Filial</span>
          </a>
        </div>
      </div>

    </div>

  </div>
</section>
