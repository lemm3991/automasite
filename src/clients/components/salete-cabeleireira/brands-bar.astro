---
import './editorial.css';

interface Props {
  content?: {
    title?: string;
  };
}

const { content = {} } = Astro.props;
const title = content.title || "Parcerias Globais de Alta Performance";
---

<section id="marcas" class="py-20 sm:py-24 bg-[#0c0c0e] text-white border-t border-white/5 relative" data-surface-rhythm="editorial-noir-rhythm" data-card-treatment="minimal-glass-stroke">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-2xl mx-auto space-y-3 mb-12">
      <span class="text-xs uppercase tracking-widest text-[#803050] font-semibold">Excelência em Produtos</span>
      <h2 class="font-serif text-3xl sm:text-4xl font-normal text-white">
        {title}
      </h2>
      <p class="text-sm text-white/70 font-light">
        Tecnologia cosmética de ponta para nutrição, brilho e reconstrução capilar duradoura.
      </p>
    </div>

    <!-- Galeria de Marcas e Produtos Autênticos -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-center">
      
      <!-- Card Kérastase -->
      <div class="p-6 rounded-2xl bg-white/[0.02] border border-white/10 hover:border-white/20 transition-all text-center space-y-4">
        <div class="h-44 rounded-xl overflow-hidden border border-white/10">
          <img src="/assets/clients/salete-cabeleireira/03-salao-de-beleza-salete-cabeleireira-4.jpg" alt="Produtos Kérastase no Salão Salete" class="w-full h-full object-cover filter brightness-90 hover:scale-105 transition-transform duration-500" />
        </div>
        <h3 class="font-serif italic text-xl font-bold text-white">Kérastase Paris</h3>
        <p class="text-xs text-white/65 font-light leading-relaxed">
          Rituais exclusivos de nutrição, regeneração capilar Chronologiste e proteção da cor Chroma Captive.
        </p>
      </div>

      <!-- Card Wella Professionals -->
      <div class="p-6 rounded-2xl bg-white/[0.02] border border-white/10 hover:border-white/20 transition-all text-center space-y-4">
        <div class="h-44 rounded-xl overflow-hidden border border-white/10">
          <img src="/assets/clients/salete-cabeleireira/20-salao-de-beleza-salete-cabeleireira-wella-professionals.jpg" alt="Wella Professionals" class="w-full h-full object-cover filter brightness-90 hover:scale-105 transition-transform duration-500" />
        </div>
        <h3 class="font-serif italic text-xl font-bold text-white">Wella Professionals</h3>
        <p class="text-xs text-white/65 font-light leading-relaxed">
          Alta fidelidade em colorações Koleston Perfect, descolorações suaves Blondor e tratamentos de restauração.
        </p>
      </div>

      <!-- Card L'Oréal Professionnel -->
      <div class="p-6 rounded-2xl bg-white/[0.02] border border-white/10 hover:border-white/20 transition-all text-center space-y-4">
        <div class="h-44 rounded-xl overflow-hidden border border-white/10 bg-white/5 flex items-center justify-center p-4">
          <img src="/assets/clients/salete-cabeleireira/01-salao-de-beleza-salete-cabeleireira-logo.png" alt="Salão de Beleza Salete Cabeleireira" class="max-h-24 w-auto object-contain filter drop-shadow opacity-90" />
        </div>
        <h3 class="font-serif italic text-xl font-bold text-white">L'Oréal & Tratamentos</h3>
        <p class="text-xs text-white/65 font-light leading-relaxed">
          Gamas de cuidado intensivo e fórmulas desenvolvidas para manter fios alinhados, sedosos e resistentes.
        </p>
      </div>

    </div>

  </div>
</section>
