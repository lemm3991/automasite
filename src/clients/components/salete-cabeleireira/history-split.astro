---
import './editorial.css';

interface Props {
  content?: {
    title?: string;
    subtitle?: string;
  };
}

const { content = {} } = Astro.props;
const title = content.title || "Uma Trajetória Consagrada na Beleza";
---

<section id="historia" class="py-20 sm:py-28 bg-[#0f0f11] text-white border-t border-white/5 relative" data-surface-rhythm="editorial-noir-rhythm" data-card-treatment="minimal-glass-stroke">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- Coluna Visual / Fotografia Autêntica -->
      <div class="lg:col-span-5 relative">
        <div class="relative rounded-2xl overflow-hidden border border-white/10 shadow-2xl">
          <img src="/assets/clients/salete-cabeleireira/05-salao-de-beleza-salete-cabeleireira-1.jpg" alt="Estações de atendimento do Salão Salete" class="w-full h-[480px] object-cover object-center filter brightness-95 hover:scale-105 transition-transform duration-700" />
          <div class="absolute inset-0 bg-gradient-to-t from-[#0f0f11]/80 via-transparent to-transparent"></div>
          <div class="absolute bottom-6 left-6 right-6 p-4 rounded-xl bg-black/60 backdrop-blur-md border border-white/10">
            <p class="text-xs font-serif italic text-white/90">Estações de atendimento do Salão Salete</p>
          </div>
        </div>
      </div>

      <!-- Coluna de Narrativa Editorial e Credenciais -->
      <div class="lg:col-span-7 space-y-6">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white/5 border border-white/10 text-xs font-semibold tracking-wider text-[#803050] uppercase">
          <span>Legado & Maestria Técnica</span>
        </div>

        <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-normal text-[#fcfbfb] leading-tight">
          {title}
        </h2>

        <p class="text-base sm:text-lg text-white/80 leading-relaxed font-light">
          Entre em um espaço onde cada atendimento expressa arte e precisão clássica. Desde a infância em São Bento Baixo (Nova Veneza/SC), Salete demonstrava vocação singular pela arte dos cabelos, aprimorando seu talento nos mais conceituados salões de Florianópolis.
        </p>

        <p class="text-sm sm:text-base text-white/70 leading-relaxed font-light">
          Retornando ao sul catarinense para inaugurar seu salão em Criciúma, construiu uma trajetória consagrada tornando-se referência em todo o Estado de Santa Catarina por sua dedicação e excelência.
        </p>

        <!-- Credenciais Internacionais de Destaque -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4">
          <div class="p-5 rounded-xl bg-white/5 border border-white/10 space-y-2">
            <span class="text-xs uppercase tracking-widest text-[#803050] font-semibold">Formação Internacional</span>
            <h3 class="font-serif text-lg font-medium text-white">Vidal Sassoon</h3>
            <p class="text-xs text-white/65 leading-relaxed">Aperfeiçoamento na mais prestigiosa academia britânica de visagismo e geometria capilar.</p>
          </div>

          <div class="p-5 rounded-xl bg-white/5 border border-white/10 space-y-2">
            <span class="text-xs uppercase tracking-widest text-[#803050] font-semibold">Academia em Londres</span>
            <h3 class="font-serif text-lg font-medium text-white">Academia TONI&GUY</h3>
            <p class="text-xs text-white/65 leading-relaxed">Técnicas de styling contemporâneo, vanguarda europeia e colorimetria de alto padrão.</p>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>
