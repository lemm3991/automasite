---
import './editorial.css';

interface Props {
  content?: {
    title?: string;
    subtitle?: string;
  };
}

const { content = {} } = Astro.props;
const title = content.title || "Agendamento & Atendimento Exclusivo";
---

<section id="contato" class="py-20 sm:py-28 bg-[#0a0a0c] text-white border-t border-white/5 relative" data-surface-rhythm="editorial-noir-rhythm" data-card-treatment="minimal-glass-stroke">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      
      <!-- Informações de Atendimento e Canais Oficiais -->
      <div class="lg:col-span-5 space-y-8">
        <div class="space-y-4">
          <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white/5 border border-white/10 text-xs font-semibold tracking-wider text-[#803050] uppercase">
            <span>Fale Conosco</span>
          </div>
          <h2 class="font-serif text-3xl sm:text-4xl font-normal text-white">
            {title}
          </h2>
          <p class="text-sm text-white/70 font-light leading-relaxed">
            Reserve seu atendimento com nossa equipe de especialistas. Estamos à sua disposição em Criciúma e Balneário Rincão.
          </p>
        </div>

        <div class="space-y-4 text-sm font-light">
          <div class="p-4 rounded-xl bg-white/[0.02] border border-white/10 space-y-1">
            <span class="text-xs uppercase tracking-widest text-[#803050] font-semibold">E-mail Oficial</span>
            <p><a href="mailto:contato@saletecabeleireira.com.br" class="text-white hover:underline">contato@saletecabeleireira.com.br</a></p>
          </div>

          <div class="p-4 rounded-xl bg-white/[0.02] border border-white/10 space-y-2">
            <span class="text-xs uppercase tracking-widest text-[#803050] font-semibold">Atendimento Telefônico</span>
            <div class="flex items-center justify-between text-white text-xs">
              <span class="text-white/70">Matriz Criciúma</span>
              <a href="tel:4834331789" class="font-medium text-white hover:underline">48 3433 1789</a>
            </div>
            <div class="flex items-center justify-between text-white text-xs">
              <span class="text-white/70">Filial Rincão</span>
              <a href="tel:4834681297" class="font-medium text-white hover:underline">48 3468 1297</a>
            </div>
          </div>
        </div>

        <div>
          <a href="https://wa.me/554834331789?text=Olá,%20gostaria%20de%20agendar%20um%20atendimento%20no%20Salão%20Salete" class="inline-flex items-center justify-center gap-2 w-full py-4 px-6 rounded-full bg-[#803050] hover:bg-[#802050] font-semibold text-sm text-white transition-colors shadow-lg">
            <span>Iniciar Agendamento por WhatsApp</span>
          </a>
        </div>
      </div>

      <!-- Formulário de Mensagem Direta -->
      <div class="lg:col-span-7">
        <div class="p-8 sm:p-10 rounded-3xl bg-white/[0.03] border border-white/10 space-y-6">
          <h3 class="font-serif text-2xl font-medium text-white">Deixe sua Mensagem</h3>
          <p class="text-xs text-white/60 font-light">Preencha os campos abaixo e entraremos em contato com você o mais breve possível.</p>
          
          <form id="formcontato" class="space-y-4">
            <div>
              <label for="nome" class="block text-xs uppercase tracking-wider text-white/70 mb-1">Nome Completo</label>
              <input type="text" id="nome" name="nome" placeholder="Seu nome" class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 text-white text-sm focus:outline-none focus:border-[#803050] transition-colors" />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="telefone" class="block text-xs uppercase tracking-wider text-white/70 mb-1">Telefone / WhatsApp</label>
                <input type="text" id="telefone" name="telefone" placeholder="(48) 99999-9999" class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 text-white text-sm focus:outline-none focus:border-[#803050] transition-colors" />
              </div>
              <div>
                <label for="email" class="block text-xs uppercase tracking-wider text-white/70 mb-1">E-mail</label>
                <input type="email" id="email" name="email" placeholder="seu@email.com" class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 text-white text-sm focus:outline-none focus:border-[#803050] transition-colors" />
              </div>
            </div>

            <div>
              <label for="mensagem" class="block text-xs uppercase tracking-wider text-white/70 mb-1">Mensagem</label>
              <textarea id="mensagem" name="mensagem" rows="4" placeholder="Como podemos ajudar você?" class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 text-white text-sm focus:outline-none focus:border-[#803050] transition-colors"></textarea>
            </div>

            <button type="submit" class="w-full py-3.5 px-6 rounded-full bg-white/10 hover:bg-white/20 border border-white/20 text-white font-semibold text-sm transition-colors">
              Enviar Mensagem
            </button>
          </form>
        </div>
      </div>

    </div>
  </div>
</section>
