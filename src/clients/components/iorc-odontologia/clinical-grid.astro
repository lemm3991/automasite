---
import './medical.css';
interface Props {
  content?: {
    title?: string;
    subtitle?: string;
    categories?: Array<{
      title: string;
      items: Array<{ name: string; desc: string }>;
    }>;
  };
}

const { content = {} } = Astro.props;
const title = content.title || "Especialidades e Tratamentos Integrados";
const subtitle = content.subtitle || "Corpo clínico multidisciplinar e estrutura completa para cuidar de todas as fases do seu sorriso.";

const servicesList = [
  {
    category: "Ortodontia Especializada",
    badge: "Carro-chefe",
    services: [
      { name: "Aparelho Invisível (Alinhadores)", desc: "Tratamento discreto com tecnologia Invisalign e ClearCorrect para correção rápida e confortável." },
      { name: "Aparelho Estético (Safira)", desc: "Braquetes translúcidos de máxima discrição e alta resistência mecânica." },
      { name: "Aparelho Tradicional (Metal)", desc: "Precisão biomecânica clássica para correções ortodônticas completas." }
    ]
  },
  {
    category: "Odontologia & Implantes",
    badge: "Reabilitação Oral",
    services: [
      { name: "Implantes Dentários", desc: "Cirurgia guiada e titânio de precisão Neodent para reposição dentária definitiva." },
      { name: "Próteses Dentárias", desc: "Soluções fixas e removíveis com conforto oclusal e estética natural." },
      { name: "Endodontia & Restaurações", desc: "Tratamento de canal especializado e restaurações estéticas de alta durabilidade." }
    ]
  },
  {
    category: "Estética & Harmonização",
    badge: "Design do Sorriso",
    services: [
      { name: "Facetas e Lentes de Contato", desc: "Lâminas cerâmicas ultrafinas para alinhamento de forma, cor e harmonia do sorriso." },
      { name: "Clareamento Dental", desc: "Opções de consultório e moldeira individualizada com supervisão odontológica." },
      { name: "Harmonização Orofacial", desc: "Aplicação terapêutica de toxina botulínica e preenchimento facial integrado." }
    ]
  }
];
---

<section id="servicos" class="py-16 sm:py-20 bg-white border-b border-slate-100" data-card-treatment="crisp-bordered-slate-panels">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mb-12">
      <h2 class="text-xs font-bold uppercase tracking-widest text-[#104050]">Procedimentos Clínicos</h2>
      <p class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-[#104050] tracking-tight mt-2">{title}</p>
      <p class="text-base text-slate-600 mt-3">{subtitle}</p>
    </div>

    <!-- Grid de Especialidades -->
    <div class="iorc-services-grid grid grid-cols-1 md:grid-cols-3 gap-8">
      {servicesList.map((cat) => (
        <div class="rounded-2xl border border-slate-200 p-6 sm:p-8 bg-slate-50 flex flex-col justify-between shadow-sm relative overflow-hidden">
          <div class="absolute top-0 right-0 left-0 h-1 bg-[#104050]"></div>
          <div>
            <div class="flex items-center justify-between gap-2 mb-4">
              <span class="text-xs font-bold uppercase tracking-wider text-[#104050] px-2.5 py-1 rounded bg-white border border-slate-200">{cat.badge}</span>
            </div>
            <h3 class="text-xl font-bold text-[#104050] mb-6">{cat.category}</h3>

            <div class="space-y-5">
              {cat.services.map((item) => (
                <div class="border-b border-slate-200/80 pb-4 last:border-b-0 last:pb-0">
                  <h4 class="text-sm font-semibold text-slate-900">{item.name}</h4>
                  <p class="text-xs text-slate-600 mt-1 leading-relaxed">{item.desc}</p>
                </div>
              ))}
            </div>
          </div>

          <div class="mt-8 pt-4 border-t border-slate-200">
            <a href="https://api.whatsapp.com/send?phone=5541999076236" class="text-xs font-semibold text-[#104050] hover:text-[#205060] inline-flex items-center gap-1">
              <span>Consultar detalhes via WhatsApp</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Destaque de Estética com Foto Clínica -->
    <div class="mt-12 rounded-2xl border border-slate-200 p-6 sm:p-8 bg-slate-50 grid grid-cols-1 md:grid-cols-12 gap-6 items-center">
      <div class="md:col-span-8">
        <span class="text-xs font-bold uppercase tracking-wider text-[#104050]">Estética Dental Avançada</span>
        <h3 class="text-xl sm:text-2xl font-bold text-[#104050] mt-1">Facetas em Porcelana e Lentes de Contato</h3>
        <p class="text-sm text-slate-600 mt-2 max-w-2xl leading-relaxed">
          Planejamento digital do sorriso com lâminas cerâmicas e clareamento dental. Transforme a estética do seu sorriso com precisão milimétrica e acabamento natural no IORC.
        </p>
      </div>
      <div class="md:col-span-4">
        <figure class="rounded-xl overflow-hidden border border-slate-200 shadow-sm">
          <img src="/assets/clients/iorc-odontologia/12-facetas2-768x512.jpeg" alt="Facetas em Porcelana e Lentes" class="w-full h-40 object-cover" width="768" height="512" />
          <figcaption class="text-[11px] text-slate-500 bg-white p-2 text-center">Facetas em Porcelana e Lentes</figcaption>
        </figure>
      </div>
    </div>
  </div>
</section>

<style>
  .clinical-divider-line {
    background: var(--grid-color);
  }
</style>
