---
import './medical.css';
interface Props {
  content?: {
    title?: string;
    metrics?: Array<{ value: string; label: string; detail: string }>;
  };
}

const { content = {} } = Astro.props;
const metrics = content.metrics || [
  { value: "1995", label: "Ano de Fundação", detail: "Idealizado pelo Dr. Fabio Takachi Hase há mais de 25 anos" },
  { value: "4.000 m²", label: "Área Total Integrada", detail: "3 clínicas somando infraestrutura ampla em Curitiba" },
  { value: "1.800 m²", label: "Matriz Alto Boqueirão", detail: "Sede própria, salas climatizadas e estacionamento" },
  { value: "CRO 9169", label: "Responsabilidade Técnica", detail: "Rigor ético, biossegurança e corpo clínico especialista" }
];
---

<section id="metricas" class="bg-slate-50 border-b border-slate-200 py-10 sm:py-12" data-surface-rhythm="clinical-sterile-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
      {metrics.map((m) => (
        <div class="p-5 rounded-xl bg-white border border-slate-200 shadow-sm flex flex-col justify-between">
          <span class="text-2xl sm:text-3xl font-extrabold text-[#104050] tracking-tight">{m.value}</span>
          <span class="text-sm font-semibold text-slate-800 mt-2">{m.label}</span>
          <span class="text-xs text-slate-500 mt-1 leading-normal">{m.detail}</span>
        </div>
      ))}
    </div>
  </div>
</section>
