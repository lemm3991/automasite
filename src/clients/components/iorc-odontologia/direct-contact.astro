---
import './medical.css';
interface Props {
  content?: {
    title?: string;
    subtitle?: string;
  };
}

const { content = {} } = Astro.props;
const title = content.title || "Agende sua Avaliação Odontológica no IORC";
const subtitle = content.subtitle || "Dê o primeiro passo para alinhar o seu sorriso ou iniciar sua reabilitação com especialistas de confiança em Curitiba.";
---

<section id="contato" class="py-16 sm:py-20 bg-[#104050] text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <div class="max-w-3xl mx-auto space-y-6">
      <span class="inline-block text-xs font-bold uppercase tracking-widest px-3 py-1 rounded-full bg-white/10 text-sky-200 border border-white/20">
        Atendimento Personalizado
      </span>
      
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight">
        {title}
      </h2>

      <p class="text-base sm:text-lg text-slate-200 max-w-2xl mx-auto leading-relaxed">
        {subtitle}
      </p>

      <div class="pt-4 flex flex-col sm:flex-row gap-4 justify-center items-center">
        <a href="https://api.whatsapp.com/send?phone=5541999076236" class="w-full sm:w-auto px-8 py-4 rounded-full bg-white text-[#104050] font-bold text-sm hover:bg-slate-100 transition-colors shadow-lg">
          <span>Agendar pelo WhatsApp da Matriz</span>
        </a>
        <a href="tel:+554130261234" class="w-full sm:w-auto px-8 py-4 rounded-full bg-transparent border border-white/40 text-white font-bold text-sm hover:bg-white/10 transition-colors flex items-center justify-center gap-1.5">
          <span>Ligue para a Matriz:</span> <span class="text-sky-200">(41) 3026-1234</span>
        </a>
      </div>

      <div class="pt-8 border-t border-white/10 text-xs text-slate-300 flex flex-col sm:flex-row justify-between items-center gap-4">
        <div>
          <span>INSTITUTO DE ORTODONTIA DE CURITIBA S/S LTDA • CNPJ: 07.330.074/0001-35</span>
        </div>
        <div>
          <span>Matriz: Rua Francisco Derosso, 4567, Curitiba - PR • CRO/PR-9169</span>
        </div>
      </div>
    </div>
  </div>
</section>
