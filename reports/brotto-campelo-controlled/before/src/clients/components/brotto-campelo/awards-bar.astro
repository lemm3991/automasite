---
import './legal.css';

interface Props {
  content?: {
    title?: string;
  };
}

const { content } = Astro.props;
const title = content?.title || "Reconhecimentos & Premiações Análise Advocacia";
---

<section class="w-full bg-[#f8fafc] py-12 md:py-16 px-4 md:px-8 border-b border-gray-100">
  <div class="max-w-7xl mx-auto flex flex-col items-center">
    <div class="text-center mb-8 max-w-2xl">
      <span class="text-xs font-semibold uppercase tracking-widest text-[#e06020] mb-2 block">
        Excelência Comprovada
      </span>
      <h2 class="text-2xl md:text-3xl font-normal text-[#111827]" style="font-family: 'Playfair Display', serif;">
        {title}
      </h2>
      <p class="text-xs md:text-sm text-gray-500 mt-2 font-light">
        Escritório destacado consecutivamente entre os mais admirados do Brasil e do Sul do país.
      </p>
    </div>

    <!-- Linhas arquitetonicas sutis de contencao inspiradas no architecture-studio -->
    <div class="w-full max-w-5xl mx-auto border-x border-[#C4CFC0]/60 p-6 md:p-8 bg-white rounded-xl shadow-xs">
      <div class="bca-awards-bar items-center">
        <!-- Card Selo 2026 -->
        <div class="flex flex-col items-center text-center p-4 rounded-lg bg-gray-50/50 hover:bg-gray-50 transition-colors">
          <img
            src="/assets/clients/brotto-campelo/04-SELO-2026-esc-mais-admirado-analise-advocacia-BCA.png"
            alt="Selo oficial Análise Advocacia 2026 concedido ao escritório Brotto Campelo Advogados."
            class="h-24 md:h-28 w-auto object-contain mb-3"
            width="120"
            height="160"
          />
          <h3 class="text-sm font-semibold text-gray-900">Análise Advocacia 2026</h3>
          <p class="text-xs text-gray-500 mt-1">Escritório Mais Admirado Análise Advocacia 2026</p>
        </div>

        <!-- Card Selo 2025 -->
        <div class="flex flex-col items-center text-center p-4 rounded-lg bg-gray-50/50 hover:bg-gray-50 transition-colors">
          <img
            src="/assets/clients/brotto-campelo/08-SELO-2025_escritorio_mais_admirado.png"
            alt="Selo Análise Advocacia 2025 Escritório Mais Admirado."
            class="h-24 md:h-28 w-auto object-contain mb-3"
            width="120"
            height="160"
          />
          <h3 class="text-sm font-semibold text-gray-900">Análise Advocacia 2025</h3>
          <p class="text-xs text-gray-500 mt-1">Escritório Mais Admirado Análise 2025</p>
        </div>

        <!-- Card Selo 2024 Regional -->
        <div class="flex flex-col items-center text-center p-4 rounded-lg bg-gray-50/50 hover:bg-gray-50 transition-colors">
          <img
            src="/assets/clients/brotto-campelo/11-SELO-REGIONAL-ESCRITORIO-MAIS-ADMIRADO-2024.jpg"
            alt="Selo Escritório Mais Admirado Regional 2024 Análise Advocacia."
            class="h-24 md:h-28 w-auto object-contain mb-3"
            width="120"
            height="160"
          />
          <h3 class="text-sm font-semibold text-gray-900">Análise Regional 2024</h3>
          <p class="text-xs text-gray-500 mt-1">Escritório Mais Admirado Regional 2024</p>
        </div>
      </div>
    </div>
  </div>
</section>
