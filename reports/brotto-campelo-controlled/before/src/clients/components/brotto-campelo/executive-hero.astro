---
import './legal.css';

interface Props {
  content?: {
    tagline?: string;
    title?: string;
    subtitle?: string;
    ctaText?: string;
    ctaLink?: string;
  };
}

const { content } = Astro.props;
const title = content?.title || "Soluções jurídicas inovadoras";
const subtitle = content?.subtitle || "O Brotto Campelo Advogados nasceu da união entre experiência e inovação, com forte atuação em Direito Empresarial e Imobiliário, além de outras áreas estratégicas. Somos um escritório premiado nacionalmente e referência entre os mais admirados do Sul do país, sempre atuando como parceiros estratégicos dos clientes. Nossa advocacia é moderna e dinâmica, pautada em transparência, proximidade e soluções jurídicas personalizadas que viabilizam negócios e fortalecem relações.";
const ctaText = content?.ctaText || "Agendar Consulta Jurídica";
const ctaLink = content?.ctaLink || "#contato";
---

<header class="w-full bg-white border-b border-gray-100 py-3 px-4 md:px-8 sticky top-0 z-50">
  <div class="max-w-7xl mx-auto flex items-center justify-between">
    <div class="flex items-center gap-3">
      <img
        id="bca-logo"
        src="/assets/clients/brotto-campelo/01-BCA-logos-03-1024x205.png"
        alt="Logotipo horizontal oficial Brotto Campelo Advogados em tipografia sóbria azul petróleo."
        class="h-8 md:h-10 w-auto object-contain"
        width="200"
        height="40"
      />
    </div>
    <div class="flex items-center gap-4">
      <span class="hidden md:inline-block text-xs font-semibold uppercase tracking-wider text-gray-500">
        Rua Padre Agostinho 1926 - Bigorrilho, Curitiba - PR
      </span>
      <a
        href="#contato"
        class="inline-flex items-center justify-center px-4 py-2 text-xs font-medium uppercase tracking-wider text-white bg-[#0693e3] rounded-full hover:bg-blue-600 transition-colors"
      >
        <span>Fale Conosco</span>
      </a>
    </div>
  </div>
</header>

<section
  id="bca-hero"
  class="relative w-full bg-white py-6 md:py-14 px-4 md:px-8 border-b border-gray-100"
  data-surface-rhythm="generous-executive"
  data-card-treatment="minimal-editorial"
>
  <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-12 items-center">
    <!-- Coluna de Conteúdo -->
    <div class="md:col-span-7 flex flex-col items-start gap-4">
      <div class="bca-badge inline-flex items-center gap-2 px-3 py-1 rounded-full bg-gray-50 border border-gray-200 text-xs font-medium text-gray-700">
        <span class="w-2 h-2 rounded-full bg-[#e06020]"></span>
        <span>BROTTO CAMPELO ADVOGADOS • CURITIBA/PR</span>
      </div>

      <h1
        class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-normal text-[#111827] tracking-tight leading-[1.15]"
        style="font-family: 'Playfair Display', serif;"
      >
        {title}
      </h1>

      <p class="text-sm md:text-base text-gray-600 leading-relaxed max-w-xl font-light">
        {subtitle}
      </p>

      <div class="pt-2 flex flex-wrap items-center gap-4 w-full sm:w-auto">
        <a
          href={ctaLink}
          class="bca-cta-btn inline-flex items-center justify-center px-6 py-3.5 text-xs md:text-sm font-semibold uppercase tracking-wider text-white bg-[#0693e3] rounded-full shadow-sm hover:bg-blue-600 transition-all w-full sm:w-auto text-center"
        >
          <span>{ctaText}</span>
        </a>
        <a
          href="#areas"
          class="inline-flex items-center justify-center px-5 py-3.5 text-xs md:text-sm font-medium uppercase tracking-wider text-[#32373c] border border-gray-200 rounded-full hover:bg-gray-50 transition-all w-full sm:w-auto text-center"
        >
          <span>Áreas de Atuação</span>
        </a>
      </div>
    </div>

    <!-- Coluna de Imagem dos Sócios -->
    <div class="md:col-span-5 flex justify-center md:justify-end">
      <div class="bca-hero-photo relative rounded-2xl overflow-hidden border border-gray-100 shadow-sm max-w-[280px] sm:max-w-[340px] md:max-w-none">
        <img
          src="/assets/clients/brotto-campelo/20-Natalia-e-Ricardo-home-683x1024.jpg"
          alt="Fotografia conjunta dos sócios-fundadores Natália Brotto e Ricardo Campelo."
          class="w-full h-auto object-cover max-h-[300px] sm:max-h-[380px] md:max-h-[500px]"
          width="400"
          height="600"
        />
        <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-black/70 via-black/30 to-transparent p-4 text-white">
          <p class="text-xs font-medium tracking-wide">Natália Brotto e Ricardo Campelo — Sócios-fundadores</p>
        </div>
      </div>
    </div>
  </div>
</section>
