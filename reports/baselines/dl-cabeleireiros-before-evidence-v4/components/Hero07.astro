---
import './salon.css';
interface Props {
  content: {
    eyebrow?: string;
    headline: string;
    subheadline?: string;
    featuredImage?: string;
    imageAlt?: string;
    primaryCtaLabel?: string;
    primaryCtaHref?: string;
    secondaryCtaLabel?: string;
    secondaryCtaHref?: string;
    metrics?: Array<{ label: string; value: string; note: string }>;
  };
  client?: any;
}

const { content, client } = Astro.props;
const eyebrow = content?.eyebrow || "D&L CABELEIREIROS · PEDRA BRANCA, PALHOÇA / SC";
const headline = content?.headline || "Beleza e excelência em cada detalhe.";
const subheadline = content?.subheadline || "Sua beleza elevada ao mais alto nível com técnica, cuidado e atenção a cada detalhe. Cortes autorais, mechas, mega hair e tratamentos capilares premium.";
const featuredImage = content?.featuredImage || "/assets/clients/dl-cabeleireiros/03-whatsapp-image-2026-03-11-at-13.25.26-W6QUkRMQrgKOxaJJ.jpeg";
const imageAlt = content?.imageAlt || "Transformação capilar no salão D&L Cabeleireiros";
const primaryCtaLabel = content?.primaryCtaLabel || "Agendar em Palhoça";
const primaryCtaHref = content?.primaryCtaHref || "https://wa.me/5548999360284";
const secondaryCtaLabel = content?.secondaryCtaLabel || "Conhecer Serviços";
const secondaryCtaHref = content?.secondaryCtaHref || "#servicos";
const metrics = content?.metrics || [
  { value: "Pedra Branca", label: "Unidade Palhoça", note: "Rua Portinari, 170" },
  { value: "Agronômica", label: "Unidade Florianópolis", note: "Rua Frei Caneca, 17" },
  { value: "Douglas & Luciano", label: "Fundadores", note: "Excelência e Alto Padrão" }
];
---

<section id="hero" class="dl-hero" data-composition="split" data-hero-type="split" data-card-treatment="luxury-bordered" data-surface-rhythm="continuous">
  <div class="dl-wrap dl-hero-grid">
    <div class="dl-hero-content">
      <div class="dl-badge">
        <span class="section-tag-line"></span>
        <span class="text-[0.65rem] font-semibold uppercase tracking-[0.25em] text-gray-400">{eyebrow}</span>
      </div>

      <h1>{headline}</h1>

      <p class="dl-hero-desc">{subheadline}</p>

      <div class="dl-hero-actions">
        <a href={primaryCtaHref} target="_blank" rel="noopener noreferrer" class="dl-button">
          <span>{primaryCtaLabel}</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
        </a>
        <a href={secondaryCtaHref} class="dl-button-outline">
          <span>{secondaryCtaLabel}</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M19 12l-7 7-7-7"/></svg>
        </a>
      </div>

      <div class="dl-credentials-bar">
        {metrics.map((m) => (
          <div class="dl-cred-item">
            <strong>{m.value}</strong>
            <span>{m.label} — {m.note}</span>
          </div>
        ))}
      </div>
    </div>

    <div class="dl-hero-media">
      <div class="dl-hero-img-wrap">
        <img src={featuredImage} alt={imageAlt} width="768" height="956" fetchpriority="high" loading="eager" />
      </div>
      <div class="dl-floating-badge">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-amber-100 text-amber-700 flex items-center justify-center font-bold text-sm">
            D&L
          </div>
          <div>
            <div class="text-xs font-semibold text-gray-900">Salão Premium em Palhoça</div>
            <div class="text-[11px] text-gray-500">Pedra Branca · Terça a Sábado</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
