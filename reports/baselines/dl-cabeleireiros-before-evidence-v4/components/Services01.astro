---
import './salon.css';
interface Props {
  content: {
    title?: string;
    description?: string;
    services: Array<{
      title: string;
      description: string;
      category?: string;
    }>;
  };
}

const { content } = Astro.props;
const title = content?.title || "Nossos Serviços Especializados";
const description = content?.description || "No D&L Cabeleireiros, cada procedimento é executado com técnicas modernas, produtos de alta qualidade e atendimento personalizado para garantir resultados impecáveis.";
const services = content?.services || [];
---

<section id="servicos" class="dl-section" data-card-treatment="luxury-bordered" data-surface-rhythm="continuous">
  <div class="dl-wrap">
    <div class="max-w-2xl">
      <div class="dl-badge">
        <span class="section-tag-line"></span>
        <span class="text-xs font-semibold uppercase tracking-wider text-amber-700">O que oferecemos</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900 mb-4">{title}</h2>
      <p class="text-base text-gray-600 leading-relaxed">{description}</p>
    </div>

    <!-- Layout com proporção visual inspirada no parallax-clean -->
    <div class="dl-services-featured mt-12 mb-8 hidden lg:block" style="grid-template-columns: 1fr 1.2fr;">
      <div class="p-8 bg-stone-100 rounded-2xl border border-stone-200 flex flex-col justify-between">
        <div>
          <span class="text-xs font-bold text-amber-700 uppercase tracking-widest">Protocolo de Destaque</span>
          <h3 class="text-2xl font-bold text-gray-900 mt-2 mb-3">Transformação & Iluminação</h3>
          <p class="text-sm text-gray-600 leading-relaxed">
            Ilumine seu cabelo com tons naturais e sofisticados. Técnicas exclusivas de mechas, morena iluminada e loiros saudáveis com manutenção da integridade dos fios.
          </p>
        </div>
        <div class="mt-6 flex items-center gap-2 text-xs font-semibold text-gray-900">
          <span>Unidades Palhoça & Florianópolis</span>
        </div>
      </div>
    </div>

    <div class="dl-services-grid">
      {services.map((item) => (
        <div class="dl-service-card">
          <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-800 flex items-center justify-center font-bold text-sm mb-4">
            ✦
          </div>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
          <div class="pt-4 border-t border-gray-100 mt-auto flex items-center justify-between text-xs font-medium text-amber-800">
            <span>Atendimento Personalizado</span>
            <span>→</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
