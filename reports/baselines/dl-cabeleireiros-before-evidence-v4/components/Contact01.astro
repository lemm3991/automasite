---
import './salon.css';
interface Props {
  content: {
    title?: string;
    description?: string;
    whatsappPalhoca?: string;
    whatsappFloripa?: string;
  };
}

const { content } = Astro.props;
const title = content?.title || "Agende seu Atendimento";
const description = content?.description || "Entre em contato diretamente pelo WhatsApp com a equipe da unidade de sua preferência para consultar horários, procedimentos e tirar dúvidas.";
const whatsappPalhoca = content?.whatsappPalhoca || "5548999360284";
const whatsappFloripa = content?.whatsappFloripa || "5548999360365";
---

<section id="contato" class="dl-section" data-card-treatment="luxury-bordered" data-surface-rhythm="continuous">
  <div class="dl-wrap">
    <div class="dl-contact-grid">
      <div>
        <div class="dl-badge">
          <span class="text-xs font-semibold uppercase tracking-wider text-amber-700">Fale Conosco</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900 mb-4">{title}</h2>
        <p class="text-base text-gray-600 leading-relaxed mb-8">{description}</p>

        <div class="space-y-6">
          <div class="p-6 bg-stone-50 rounded-2xl border border-stone-200">
            <div class="text-xs font-bold uppercase tracking-widest text-amber-800 mb-1">Unidade Palhoça (Pedra Branca)</div>
            <div class="text-lg font-bold text-gray-900">(48) 99936-0284</div>
            <p class="text-xs text-gray-500 mt-1">Rua Portinari, 170 · Seg a Sáb das 09h às 21h</p>
            <a href={`https://wa.me/${whatsappPalhoca}`} target="_blank" rel="noopener noreferrer" class="dl-button mt-4 text-xs">
              <span>Chamar WhatsApp Palhoça</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17l9.2-9.2M17 17V8H8"/></svg>
            </a>
          </div>

          <div class="p-6 bg-stone-50 rounded-2xl border border-stone-200">
            <div class="text-xs font-bold uppercase tracking-widest text-amber-800 mb-1">Unidade Florianópolis (Agronômica)</div>
            <div class="text-lg font-bold text-gray-900">(48) 99936-0365</div>
            <p class="text-xs text-gray-500 mt-1">Rua Frei Caneca, 17 · Seg a Sáb das 09h às 21h30</p>
            <a href={`https://wa.me/${whatsappFloripa}`} target="_blank" rel="noopener noreferrer" class="dl-button-outline mt-4 text-xs">
              <span>Chamar WhatsApp Floripa</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17l9.2-9.2M17 17V8H8"/></svg>
            </a>
          </div>
        </div>
      </div>

      <div class="flex flex-col justify-center bg-stone-50 p-8 rounded-2xl border border-stone-200">
        <h3 class="text-xl font-bold text-gray-900 mb-2">Mensagem Rápida</h3>
        <p class="text-xs text-gray-500 mb-6">Envie sua dúvida ou solicite um horário para retorno de nossa recepção.</p>

        <form class="space-y-4" onsubmit="event.preventDefault(); window.open('https://wa.me/5548999360284', '_blank');">
          <div>
            <label class="block text-xs font-medium text-gray-700 mb-1">Seu Nome</label>
            <input type="text" required placeholder="Como podemos te chamar?" class="w-full px-4 py-3 rounded-xl border border-gray-200 bg-white text-sm focus:outline-none focus:border-amber-600" />
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-700 mb-1">Telefone / WhatsApp</label>
            <input type="tel" required placeholder="(48) 99999-9999" class="w-full px-4 py-3 rounded-xl border border-gray-200 bg-white text-sm focus:outline-none focus:border-amber-600" />
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-700 mb-1">Procedimento de Interesse</label>
            <select class="w-full px-4 py-3 rounded-xl border border-gray-200 bg-white text-sm focus:outline-none focus:border-amber-600">
              <option>Corte Personalizado</option>
              <option>Mechas & Iluminação</option>
              <option>Mega Hair & Volume</option>
              <option>Tratamento Capilar & Cronograma</option>
              <option>Outros Serviços</option>
            </select>
          </div>
          <button type="submit" class="dl-button w-full mt-4">
            <span>Iniciar Contato pelo WhatsApp</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
          </button>
        </form>
      </div>
    </div>
  </div>
</section>
