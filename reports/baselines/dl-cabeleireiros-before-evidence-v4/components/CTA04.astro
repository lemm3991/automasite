---
import './salon.css';
interface Props {
  content: {
    headline?: string;
    subheadline?: string;
    primaryCtaLabel?: string;
    primaryCtaHref?: string;
  };
}

const { content } = Astro.props;
const headline = content?.headline || "Estamos prontos para cuidar de você.";
const subheadline = content?.subheadline || "Agende uma consulta ou procedimento e experimente o padrão de sofisticação e excelência da D&L Cabeleireiros na Pedra Branca em Palhoça.";
const primaryCtaLabel = content?.primaryCtaLabel || "Agendar Agora no WhatsApp";
const primaryCtaHref = content?.primaryCtaHref || "https://wa.me/5548999360284";
---

<section id="cta-final" class="dl-wrap" data-card-treatment="luxury-bordered" data-surface-rhythm="continuous">
  <div class="dl-cta-section">
    <h2>{headline}</h2>
    <p>{subheadline}</p>
    <div class="flex justify-center">
      <a href={primaryCtaHref} target="_blank" rel="noopener noreferrer" class="dl-button bg-amber-600 hover:bg-amber-500 text-white font-bold py-4 px-8 text-base">
        <span>{primaryCtaLabel}</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
      </a>
    </div>
  </div>
</section>
